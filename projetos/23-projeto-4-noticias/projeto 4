      "source": [
        "import re\n",
        "\n",
        "stopwords_pequenas = {\"a\", \"o\", \"as\", \"os\", \"de\", \"da\", \"do\", \"das\", \"dos\", \"em\", \"no\", \"na\",\n",
        "                      \"nos\", \"nas\", \"um\", \"uma\", \"para\", \"por\", \"com\", \"que\", \"e\", \"se\", \"ao\",\n",
        "                      \"foi\", \"ser\", \"são\", \"mais\"}\n",
        "\n",
        "def preparar(texto):\n",
        "    texto = str(texto).lower()\n",
        "    texto = re.sub(r\"https?://\\S+\", \" \", texto)\n",
        "    tokens = re.findall(r\"\\b[^\\W\\d_]+\\b\", texto, flags=re.UNICODE)\n",
        "    return \" \".join(t for t in tokens if t not in stopwords_pequenas)\n",
        "\n",
        "politica[\"texto_preparado\"] = politica[\"texto_analise\"].map(preparar)\n",
        "\n",
        "print(\"Vazios antes:\", politica[\"texto_analise\"].str.strip().eq(\"\").sum())\n",
        "print(\"Vazios depois:\", politica[\"texto_preparado\"].str.strip().eq(\"\").sum())\n",
        "print(\"Duplicatas antes:\", politica[\"texto_analise\"].duplicated().sum())\n",
        "print(\"Duplicatas depois:\", politica[\"texto_preparado\"].duplicated().sum())\n",
        "print(\"Tokens antes:\", politica[\"texto_analise\"].str.split().str.len().sum())\n",
        "print(\"Tokens depois:\", politica[\"texto_preparado\"].str.split().str.len().sum())"
